diff --git a/internal/golden/golden.go b/internal/golden/golden.go
new file mode 100644
index 0000000..5aff443
--- /dev/null
+++ b/internal/golden/golden.go
@@ -0,0 +1,77 @@
+// Package golden holds the deterministic-oracle hooks of the H0 harness copy.
+package golden
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"io"
+	"sync"
+	"time"
+)
+
+var (
+	mu      sync.Mutex
+	nowFunc           = time.Now
+	random  io.Reader = rand.Reader
+	counts            = map[string]int{}
+	// XPCTrace observes runtime<->daemon XPC payloads when non-nil.
+	XPCTrace func(kind string, request, reply []byte)
+)
+
+// Now returns the (possibly frozen) host time observed by guest shims.
+func Now(source string) time.Time {
+	mu.Lock()
+	defer mu.Unlock()
+	counts["time:"+source]++
+	return nowFunc()
+}
+
+// Read fills b from the (possibly seeded) random source.
+func Read(source string, b []byte) (int, error) {
+	mu.Lock()
+	defer mu.Unlock()
+	counts["rand:"+source] += len(b)
+	return io.ReadFull(random, b)
+}
+
+// Freeze makes every shim observe fixed time and a seeded SHA-256 counter stream.
+func Freeze(at time.Time, seed []byte) {
+	mu.Lock()
+	defer mu.Unlock()
+	nowFunc = func() time.Time { return at }
+	random = &stream{seed: append([]byte(nil), seed...)}
+	counts = map[string]int{}
+}
+
+// Counts returns and resets the per-source usage counters.
+func Counts() map[string]int {
+	mu.Lock()
+	defer mu.Unlock()
+	out := counts
+	counts = map[string]int{}
+	return out
+}
+
+type stream struct {
+	seed    []byte
+	counter uint64
+	buf     []byte
+}
+
+func (s *stream) Read(p []byte) (int, error) {
+	n := 0
+	for n < len(p) {
+		if len(s.buf) == 0 {
+			var c [8]byte
+			binary.BigEndian.PutUint64(c[:], s.counter)
+			s.counter++
+			h := sha256.Sum256(append(append([]byte(nil), s.seed...), c[:]...))
+			s.buf = h[:]
+		}
+		k := copy(p[n:], s.buf)
+		s.buf = s.buf[k:]
+		n += k
+	}
+	return n, nil
+}
diff --git a/internal/golden/wire.go b/internal/golden/wire.go
new file mode 100644
index 0000000..2707804
--- /dev/null
+++ b/internal/golden/wire.go
@@ -0,0 +1,148 @@
+package golden
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+)
+
+// WireLogEnv names the JSONL file that receives every HTTP exchange.
+const WireLogEnv = "IPAKEEP_WIRE_LOG"
+
+const maxCapturedBody = 2 << 20
+
+var wireMu sync.Mutex
+
+type wireBody struct {
+	Text    string `json:"text,omitempty"`
+	Base64  string `json:"base64,omitempty"`
+	Length  int64  `json:"length"`
+	Omitted string `json:"omitted,omitempty"`
+}
+
+type wireEntry struct {
+	Time    string              `json:"time"`
+	Layer   string              `json:"layer"`
+	Kind    string              `json:"kind"`
+	Method  string              `json:"method,omitempty"`
+	URL     string              `json:"url,omitempty"`
+	Status  int                 `json:"status,omitempty"`
+	Headers map[string][]string `json:"headers"`
+	Body    *wireBody           `json:"body,omitempty"`
+	Error   string              `json:"error,omitempty"`
+}
+
+func encodeBody(data []byte) *wireBody {
+	body := &wireBody{Length: int64(len(data))}
+	if len(data) == 0 {
+		return body
+	}
+	if utf8.Valid(data) {
+		body.Text = string(data)
+	} else {
+		body.Base64 = base64.StdEncoding.EncodeToString(data)
+	}
+	return body
+}
+
+func writeEntry(entry wireEntry) {
+	path := os.Getenv(WireLogEnv)
+	if path == "" {
+		return
+	}
+	entry.Time = time.Now().UTC().Format(time.RFC3339Nano)
+	line, err := json.Marshal(entry)
+	if err != nil {
+		return
+	}
+	wireMu.Lock()
+	defer wireMu.Unlock()
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o600)
+	if err != nil {
+		return
+	}
+	defer file.Close()
+	_, _ = file.Write(append(line, '\n'))
+}
+
+// WireRecord logs a request whose body the caller already holds.
+func WireRecord(layer string, request *http.Request, body []byte) {
+	if os.Getenv(WireLogEnv) == "" || request == nil {
+		return
+	}
+	writeEntry(wireEntry{Layer: layer, Kind: "request", Method: request.Method, URL: request.URL.String(), Headers: request.Header.Clone(), Body: encodeBody(body)})
+}
+
+// WireTransport wraps base so each request and response is appended to the wire log.
+func WireTransport(layer string, base http.RoundTripper) http.RoundTripper {
+	if base == nil {
+		base = http.DefaultTransport
+	}
+	return &wireTransport{layer: layer, base: base}
+}
+
+type wireTransport struct {
+	layer string
+	base  http.RoundTripper
+}
+
+func (t *wireTransport) RoundTrip(request *http.Request) (*http.Response, error) {
+	if os.Getenv(WireLogEnv) == "" {
+		return t.base.RoundTrip(request)
+	}
+	var body []byte
+	if request.Body != nil && request.Body != http.NoBody {
+		data, err := io.ReadAll(request.Body)
+		_ = request.Body.Close()
+		if err != nil {
+			return nil, err
+		}
+		body = data
+		request.Body = io.NopCloser(bytes.NewReader(data))
+		request.GetBody = func() (io.ReadCloser, error) { return io.NopCloser(bytes.NewReader(data)), nil }
+	}
+	WireRecord(t.layer, request, body)
+	response, err := t.base.RoundTrip(request)
+	if err != nil {
+		writeEntry(wireEntry{Layer: t.layer, Kind: "response", Method: request.Method, URL: request.URL.String(), Error: err.Error()})
+		return nil, err
+	}
+	entry := wireEntry{Layer: t.layer, Kind: "response", Method: request.Method, URL: request.URL.String(), Status: response.StatusCode, Headers: response.Header.Clone()}
+	if streaming(t.layer, response) {
+		entry.Body = &wireBody{Length: response.ContentLength, Omitted: "streaming or large body"}
+		writeEntry(entry)
+		return response, nil
+	}
+	data, readErr := io.ReadAll(response.Body)
+	_ = response.Body.Close()
+	response.Body = io.NopCloser(bytes.NewReader(data))
+	entry.Body = encodeBody(data)
+	if readErr != nil {
+		entry.Error = readErr.Error()
+	}
+	writeEntry(entry)
+	return response, readErr
+}
+
+func streaming(layer string, response *http.Response) bool {
+	if strings.HasSuffix(layer, ":transfer") || response.ContentLength > maxCapturedBody {
+		return true
+	}
+	contentType := response.Header.Get("Content-Type")
+	return response.ContentLength < 0 && strings.Contains(contentType, "octet-stream")
+}
+
+// UnwrapTransport returns the wrapped transport and a function that rewraps a replacement.
+func UnwrapTransport(rt http.RoundTripper) (http.RoundTripper, func(http.RoundTripper) http.RoundTripper) {
+	if wrapped, ok := rt.(*wireTransport); ok {
+		return wrapped.base, func(next http.RoundTripper) http.RoundTripper { return WireTransport(wrapped.layer, next) }
+	}
+	return rt, func(next http.RoundTripper) http.RoundTripper { return next }
+}
