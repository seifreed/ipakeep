@@ -0,0 +1,35 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+)
+
+func main() {
+	if len(os.Args) < 3 {
+		fmt.Fprintln(os.Stderr, "usage: h0golden sap|adi|amd|kbsync <outdir>")
+		os.Exit(2)
+	}
+	ctx := context.Background()
+	out := os.Args[2]
+	switch os.Args[1] {
+	case "sap":
+		commandSAP(ctx, out)
+	case "adi":
+		commandADI(ctx, out)
+	case "adi-verify":
+		commandADIVerify(ctx, out)
+	case "sap-verify":
+		commandSAPVerify(ctx, out)
+	case "wire-selftest":
+		commandWireSelfTest(ctx, out)
+	case "amd":
+		commandAMD(ctx, out)
+	case "kbsync":
+		commandKBSync(ctx, out)
+	default:
+		fmt.Fprintln(os.Stderr, "unknown command")
+		os.Exit(2)
+	}
+}
diff --git a/harness/common.go b/harness/common.go
new file mode 100644
index 0000000..422b7d2
--- /dev/null
+++ b/harness/common.go
@@ -0,0 +1,133 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sort"
+	"time"
+
+	"github.com/majd/ipatool/v2/internal/golden"
+	"github.com/majd/ipatool/v2/internal/sap/assets"
+)
+
+// Injected constants. All synthetic; none identifies a real device or account.
+var (
+	fixedTime     = time.Date(2026, time.November, 15, 12, 0, 0, 0, time.UTC)
+	seedPrimary   = []byte("ipakeep-h0-golden-seed-v1")
+	seedAlternate = []byte("ipakeep-h0-golden-seed-v2")
+	hardwareID    = []byte{0x02, 0x00, 0x00, 0x00, 0x00, 0x01}
+	adiIdentifier = mustHex("00112233445566778899aabbccddeeff")
+	kbsyncDSID    = uint64(1234567890)
+)
+
+const (
+	machineDSID = ^uint64(1)
+	amdDSID     = ^uint64(0)
+	userAgent   = "Configurator/2.17 (Macintosh; OS X 15.2; 24C5089c) AppleWebKit/0620.1.16.11.6"
+)
+
+func init() {
+	if value := os.Getenv("H0_ADI_ID"); value != "" {
+		adiIdentifier = mustHex(value)
+	}
+	if value := os.Getenv("H0_SEED"); value != "" {
+		seedPrimary = []byte(value)
+	}
+}
+
+func mustHex(value string) []byte {
+	data, err := hex.DecodeString(value)
+	if err != nil {
+		panic(err)
+	}
+	return data
+}
+
+type record map[string]any
+
+func hx(data []byte) string { return hex.EncodeToString(data) }
+
+func freeze(seed []byte) { golden.Freeze(fixedTime, seed) }
+
+var laterTime = fixedTime.Add(90 * time.Second)
+
+func sources() map[string]int {
+	counts := golden.Counts()
+	keys := make([]string, 0, len(counts))
+	for key := range counts {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	ordered := make(map[string]int, len(counts))
+	for _, key := range keys {
+		ordered[key] = counts[key]
+	}
+	return ordered
+}
+
+func loadBundle(ctx context.Context) assets.Bundle {
+	bundle, err := assets.Load(ctx)
+	check(err, "load assets")
+	return bundle
+}
+
+func check(err error, what string) {
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "%s: %v\n", what, err)
+		os.Exit(1)
+	}
+}
+
+func writeJSON(dir, name string, value any) {
+	check(os.MkdirAll(dir, 0o755), "mkdir")
+	data, err := json.MarshalIndent(value, "", "  ")
+	check(err, "marshal "+name)
+	check(os.WriteFile(filepath.Join(dir, name), append(data, '\n'), 0o644), "write "+name)
+}
+
+func readJSON(dir, name string, value any) {
+	data, err := os.ReadFile(filepath.Join(dir, name))
+	check(err, "read "+name)
+	check(json.Unmarshal(data, value), "decode "+name)
+}
+
+type httpExchange struct {
+	Method          string            `json:"method"`
+	URL             string            `json:"url"`
+	RequestHeaders  map[string]string `json:"request_headers"`
+	RequestBodyHex  string            `json:"request_body_hex"`
+	Status          int               `json:"status"`
+	ResponseBodyHex string            `json:"response_body_hex"`
+}
+
+func doHTTP(ctx context.Context, method, url string, headers map[string]string, body []byte) (httpExchange, []byte) {
+	request, err := http.NewRequestWithContext(ctx, method, url, bytes.NewReader(body))
+	check(err, "build request")
+	for key, value := range headers {
+		request.Header.Set(key, value)
+	}
+	client := &http.Client{Timeout: 30 * time.Second}
+	response, err := client.Do(request)
+	check(err, "http "+url)
+	defer response.Body.Close()
+	data, err := io.ReadAll(io.LimitReader(response.Body, 4<<20))
+	check(err, "read "+url)
+	if response.StatusCode != http.StatusOK {
+		fmt.Fprintf(os.Stderr, "%s returned %d: %s\n", url, response.StatusCode, data)
+		os.Exit(1)
+	}
+	return httpExchange{Method: method, URL: url, RequestHeaders: headers, RequestBodyHex: hx(body), Status: response.StatusCode, ResponseBodyHex: hx(data)}, data
+}
+
+func same(label string, a, b []byte) bool {
+	equal := bytes.Equal(a, b)
+	fmt.Printf("  %-40s %v\n", label, equal)
+	return equal
+}
diff --git a/harness/sap.go b/harness/sap.go
new file mode 100644
index 0000000..a99d27b
--- /dev/null
+++ b/harness/sap.go
@@ -0,0 +1,175 @@
+package main
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"regexp"
+
+	"github.com/majd/ipatool/v2/internal/golden"
+	"github.com/majd/ipatool/v2/internal/sap/assets"
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+	"howett.net/plist"
+)
+
+const sapVersion = uint32(200)
+
+var signInputs = [][]byte{
+	[]byte("ipakeep-h0-sign-input-0"),
+	make([]byte, 32),
+	[]byte(`<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict><key>appleId</key><string>user@example.invalid</string></dict></plist>`),
+}
+
+type sapRun struct {
+	Context    uint64
+	Exchange1  []byte
+	State1     int32
+	Exchange2  []byte
+	State2     int32
+	Signatures [][]byte
+	Sources    []map[string]int
+}
+
+func bagString(bag []byte, key string) string {
+	match := regexp.MustCompile(`<key>` + regexp.QuoteMeta(key) + `</key>\s*<string>([^<]+)</string>`).FindSubmatch(bag)
+	if match == nil {
+		check(fmt.Errorf("bag has no %s", key), "parse bag")
+	}
+	return string(match[1])
+}
+
+func plistBuffer(document []byte, key string) []byte {
+	var values map[string]any
+	_, err := plist.Unmarshal(document, &values)
+	check(err, "decode plist")
+	value, ok := values[key].([]byte)
+	if !ok {
+		check(fmt.Errorf("missing %s", key), "decode plist")
+	}
+	return value
+}
+
+// runSAP executes one full session; reply==nil means POST to Apple, else replay.
+func runSAP(ctx context.Context, bundle assets.Bundle, seed, certificate []byte, setupURL string, reply []byte) (sapRun, *httpExchange) {
+	freeze(seed)
+	if timeShift {
+		golden.Freeze(laterTime, seed)
+	}
+	var run sapRun
+	guest, err := machine.Open(ctx, bundle)
+	check(err, "open SAP machine")
+	defer guest.Close()
+	run.Sources = append(run.Sources, sources())
+
+	run.Context, err = guest.Initialize(hardwareID)
+	check(err, "initialize")
+	run.Sources = append(run.Sources, sources())
+
+	run.Exchange1, run.State1, err = guest.Exchange(sapVersion, hardwareID, run.Context, certificate)
+	check(err, "exchange 1")
+	run.Sources = append(run.Sources, sources())
+
+	var exchange *httpExchange
+	if reply == nil && setupURL == "" {
+		return run, nil
+	}
+	if reply == nil {
+		envelope, err := plist.Marshal(map[string]any{"sign-sap-setup-buffer": run.Exchange1}, plist.XMLFormat)
+		check(err, "encode setup")
+		record, body := doHTTP(ctx, http.MethodPost, setupURL, map[string]string{"Content-Type": "application/x-plist", "User-Agent": userAgent}, envelope)
+		exchange = &record
+		reply = plistBuffer(body, "sign-sap-setup-buffer")
+	}
+
+	run.Exchange2, run.State2, err = guest.Exchange(sapVersion, hardwareID, run.Context, reply)
+	check(err, "exchange 2")
+	run.Sources = append(run.Sources, sources())
+
+	for _, input := range signInputs {
+		signature, err := guest.Sign(run.Context, input)
+		check(err, "sign")
+		run.Signatures = append(run.Signatures, signature)
+	}
+	run.Sources = append(run.Sources, sources())
+	check(guest.Teardown(run.Context), "teardown")
+
+	return run, exchange
+}
+
+func compareSAP(label string, a, b sapRun) bool {
+	fmt.Println(label)
+	ok := same("context", []byte(fmt.Sprint(a.Context)), []byte(fmt.Sprint(b.Context)))
+	ok = same("exchange1", a.Exchange1, b.Exchange1) && ok
+	ok = same("exchange2", a.Exchange2, b.Exchange2) && ok
+	for index := range a.Signatures {
+		ok = same(fmt.Sprintf("signature[%d]", index), a.Signatures[index], b.Signatures[index]) && ok
+	}
+	return ok
+}
+
+func commandSAP(ctx context.Context, out string) {
+	bundle := loadBundle(ctx)
+	bagExchange, bag := doHTTP(ctx, http.MethodGet, "https://init.itunes.apple.com/bag.xml?ix=6&guid=020000000001", map[string]string{"Accept": "application/xml", "User-Agent": userAgent}, nil)
+	certURL := bagString(bag, "sign-sap-setup-cert")
+	setupURL := bagString(bag, "sign-sap-setup")
+	certExchange, certDocument := doHTTP(ctx, http.MethodGet, certURL, map[string]string{"User-Agent": userAgent}, nil)
+	certificate := plistBuffer(certDocument, "sign-sap-setup-cert")
+
+	primary, setup := runSAP(ctx, bundle, seedPrimary, certificate, setupURL, nil)
+	reply := plistBuffer(mustHex(setup.ResponseBodyHex), "sign-sap-setup-buffer")
+	replay, _ := runSAP(ctx, bundle, seedPrimary, certificate, setupURL, reply)
+	alternate, _ := runSAP(ctx, bundle, seedAlternate, certificate, "", nil)
+
+	timeShift = true
+	shifted, _ := runSAP(ctx, bundle, seedPrimary, certificate, "", nil)
+	timeShift = false
+	fmt.Println("SAP fixed_time+90s, same seed:")
+	timeIndependent := same("exchange1", primary.Exchange1, shifted.Exchange1)
+	deterministic := compareSAP("SAP replay with same seed (offline, recorded reply):", primary, replay)
+	fmt.Println("SAP alternate seed:")
+	same("context", []byte(fmt.Sprint(primary.Context)), []byte(fmt.Sprint(alternate.Context)))
+	same("exchange1", primary.Exchange1, alternate.Exchange1)
+
+	signatures := make([]record, 0, len(signInputs))
+	for index, input := range signInputs {
+		signatures = append(signatures, record{"input_hex": hx(input), "signature_hex": hx(primary.Signatures[index])})
+	}
+	_ = bagExchange
+	writeJSON(out, "sap.json", record{
+		"description":                   "FairPlay SAP v200 session: Initialize -> Exchange(cert) -> POST sign-sap-setup -> Exchange(reply) -> Sign(inputs) in order on one context",
+		"version":                       sapVersion,
+		"hardware_id_hex":               hx(hardwareID),
+		"hardware_block_hex":            hx(append(append([]byte{byte(len(hardwareID)), 0, 0, 0}, hardwareID...), make([]byte, 24-4-len(hardwareID))...)),
+		"setup_url":                     setupURL,
+		"certificate_url":               certURL,
+		"certificate_hex":               hx(certificate),
+		"certificate_http":              certExchange,
+		"context_pointer":               fmt.Sprintf("%#x", primary.Context),
+		"exchange1_input_hex":           hx(certificate),
+		"exchange1_output_hex":          hx(primary.Exchange1),
+		"exchange1_state":               primary.State1,
+		"setup_http":                    setup,
+		"exchange2_input_hex":           hx(reply),
+		"exchange2_output_hex":          hx(primary.Exchange2),
+		"exchange2_state":               primary.State2,
+		"signatures":                    signatures,
+		"exchange1_output_alt_seed_hex": hx(alternate.Exchange1),
+		"deterministic_replay":          deterministic,
+		"time_independent":              timeIndependent,
+		"observed_sources":              record{"open": primary.Sources[0], "initialize": primary.Sources[1], "exchange1": primary.Sources[2], "exchange2": primary.Sources[3], "sign_all": primary.Sources[4]},
+	})
+}
+
+// commandSAPVerify replays sap.json offline in a fresh process.
+func commandSAPVerify(ctx context.Context, out string) {
+	var fixture map[string]any
+	readJSON(out, "sap.json", &fixture)
+	certificate := mustHex(fixture["certificate_hex"].(string))
+	reply := mustHex(fixture["exchange2_input_hex"].(string))
+	run, _ := runSAP(ctx, loadBundle(ctx), seedPrimary, certificate, "offline", reply)
+	fmt.Println("SAP offline replay vs sap.json:")
+	same("exchange1", run.Exchange1, mustHex(fixture["exchange1_output_hex"].(string)))
+	for index, entry := range fixture["signatures"].([]any) {
+		same(fmt.Sprintf("signature[%d]", index), run.Signatures[index], mustHex(entry.(map[string]any)["signature_hex"].(string)))
+	}
+}
diff --git a/harness/adi.go b/harness/adi.go
new file mode 100644
index 0000000..7d06e3e
--- /dev/null
+++ b/harness/adi.go
@@ -0,0 +1,204 @@
+package main
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"fmt"
+	"net/http"
+	"strconv"
+
+	"github.com/majd/ipatool/v2/internal/golden"
+	"github.com/majd/ipatool/v2/internal/sap/assets"
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+	"howett.net/plist"
+)
+
+const (
+	machineStartURL    = "https://gsa.apple.com/grandslam/MidService/startMachineProvisioning"
+	machineFinishURL   = "https://gsa.apple.com/grandslam/MidService/finishMachineProvisioning"
+	anisetteClientInfo = "<MacBookPro13,3> <Mac OS X;10.12.6;16G29> <com.apple.AuthKit/1 (com.apple.akd/1.0)>"
+	anisetteUserAgent  = "akd/1.0 CFNetwork/811.5.4 Darwin/16.7.0"
+)
+
+type xpcPair struct {
+	Kind       string `json:"kind"`
+	RequestHex string `json:"request_hex"`
+	ReplyHex   string `json:"reply_hex"`
+}
+
+var xpcLog []xpcPair
+
+func traceXPC() {
+	xpcLog = nil
+	golden.XPCTrace = func(kind string, request, reply []byte) {
+		xpcLog = append(xpcLog, xpcPair{Kind: kind, RequestHex: hx(request), ReplyHex: hx(reply)})
+	}
+}
+
+func takeXPC() []xpcPair {
+	out := xpcLog
+	xpcLog = nil
+	return out
+}
+
+func identityHeaders(identifier []byte) (string, string) {
+	digest := sha256.Sum256(identifier)
+	encoded := hex.EncodeToString(identifier)
+	return hex.EncodeToString(digest[:]), encoded[0:8] + "-" + encoded[8:12] + "-" + encoded[12:16] + "-" + encoded[16:20] + "-" + encoded[20:32]
+}
+
+func provisioningRequest(ctx context.Context, endpoint string, values map[string]any) (httpExchange, map[string]any) {
+	body, err := plist.Marshal(map[string]any{"Header": map[string]any{}, "Request": values}, plist.XMLFormat)
+	check(err, "encode provisioning")
+	localUser, deviceID := identityHeaders(adiIdentifier)
+	headers := map[string]string{"Accept": "*/*", "Connection": "close", "Content-Type": "text/x-xml-plist", "User-Agent": anisetteUserAgent, "X-Apple-I-MD-LU": localUser, "X-MMe-Client-Info": anisetteClientInfo, "X-Mme-Device-Id": deviceID}
+	exchange, data := doHTTP(ctx, http.MethodPost, endpoint, headers, body)
+	var envelope struct {
+		Response map[string]any `plist:"Response"`
+	}
+	_, err = plist.Unmarshal(data, &envelope)
+	check(err, "decode provisioning")
+	return exchange, envelope.Response
+}
+
+func field(values map[string]any, key string) []byte {
+	text, _ := values[key].(string)
+	data, err := base64.StdEncoding.DecodeString(text)
+	if err != nil || len(data) == 0 {
+		check(fmt.Errorf("missing %s", key), "provisioning field")
+	}
+	return data
+}
+
+type adiRun struct {
+	CPIM, MID, OTP, State []byte
+	Session               uint32
+	XPC                   map[string][]xpcPair
+	Sources               map[string]map[string]int
+}
+
+// runADI provisions a fresh identity; spim/ptm/tk nil means talk to GSA.
+func runADI(ctx context.Context, bundle assets.Bundle, seed []byte, recorded *record, startOnly bool) adiRun {
+	freeze(seed)
+	traceXPC()
+	run := adiRun{XPC: map[string][]xpcPair{}, Sources: map[string]map[string]int{}}
+	adi, err := machine.OpenModernADI(ctx, bundle, adiIdentifier, nil)
+	check(err, "open ADI")
+	defer adi.Close()
+	run.Sources["open"] = sources()
+	run.XPC["open"] = takeXPC()
+
+	var spim, ptm, tk []byte
+	var rinfo string
+	if recorded == nil {
+		start, values := provisioningRequest(ctx, machineStartURL, map[string]any{})
+		spim = field(values, "spim")
+		defer func() { (*recordADI)["gsa_start_http"] = start }()
+	} else {
+		spim = mustHex((*recorded)["spim_hex"].(string))
+	}
+
+	run.CPIM, run.Session, err = adi.StartProvisioning(machineDSID, spim)
+	check(err, "start provisioning")
+	run.Sources["start_provisioning"] = sources()
+	run.XPC["start_provisioning"] = takeXPC()
+	if startOnly {
+		golden.XPCTrace = nil
+		return run
+	}
+
+	if recorded == nil {
+		finish, values := provisioningRequest(ctx, machineFinishURL, map[string]any{"cpim": base64.StdEncoding.EncodeToString(run.CPIM)})
+		ptm, tk = field(values, "ptm"), field(values, "tk")
+		rinfo, _ = values["X-Apple-I-MD-RINFO"].(string)
+		*recordADI = record{"gsa_finish_http": finish, "spim_hex": hx(spim), "ptm_hex": hx(ptm), "tk_hex": hx(tk), "rinfo": rinfo}
+	} else {
+		ptm, tk = mustHex((*recorded)["ptm_hex"].(string)), mustHex((*recorded)["tk_hex"].(string))
+	}
+
+	check(adi.EndProvisioning(run.Session, ptm, tk), "end provisioning")
+	run.Sources["end_provisioning"] = sources()
+	run.XPC["end_provisioning"] = takeXPC()
+
+	run.MID, run.OTP, err = adi.RequestOTP(machineDSID)
+	check(err, "request OTP")
+	run.Sources["request_otp"] = sources()
+	run.XPC["request_otp"] = takeXPC()
+
+	run.State, err = adi.State()
+	check(err, "state")
+	golden.XPCTrace = nil
+	return run
+}
+
+var recordADI = &record{}
+
+func commandADI(ctx context.Context, out string) {
+	bundle := loadBundle(ctx)
+	primary := runADI(ctx, bundle, seedPrimary, nil, false)
+	network := *recordADI
+	replay := runADI(ctx, bundle, seedPrimary, &network, false)
+	alternate := runADI(ctx, bundle, seedAlternate, &network, true)
+
+	fmt.Println("ADI replay same seed:")
+	ok := same("cpim", primary.CPIM, replay.CPIM)
+	ok = same("session", []byte(fmt.Sprint(primary.Session)), []byte(fmt.Sprint(replay.Session))) && ok
+	ok = same("mid", primary.MID, replay.MID) && ok
+	ok = same("otp", primary.OTP, replay.OTP) && ok
+	ok = same("state", primary.State, replay.State) && ok
+	fmt.Println("ADI alternate seed:")
+	same("cpim", primary.CPIM, alternate.CPIM)
+
+	localUser, deviceID := identityHeaders(adiIdentifier)
+	rinfo := network["rinfo"].(string)
+	_, err := strconv.ParseUint(rinfo, 10, 64)
+	check(err, "rinfo")
+	headers := map[string]string{
+		"X-Apple-I-Client-Time": fixedTime.UTC().Format("2006-01-02T15:04:05Z"),
+		"X-Apple-I-MD":          base64.StdEncoding.EncodeToString(primary.OTP),
+		"X-Apple-I-MD-M":        base64.StdEncoding.EncodeToString(primary.MID),
+		"X-Apple-I-MD-RINFO":    rinfo,
+		"X-Apple-I-MD-LU":       localUser,
+		"X-Apple-I-SRL-NO":      "0",
+		"X-Apple-I-TimeZone":    "UTC",
+		"X-Apple-Locale":        "en_US",
+		"X-Mme-Device-Id":       deviceID,
+		"X-MMe-Client-Info":     anisetteClientInfo,
+	}
+	writeJSON(out, "adi.json", record{
+		"description":          "Modern ADI (commerce+adid+fairplayd+FairPlayIOKit) machine provisioning against GSA MidService, then RequestOTP(dsid=-2)",
+		"identifier_hex":       hx(adiIdentifier),
+		"machine_dsid":         fmt.Sprintf("%#x", machineDSID),
+		"gsa_start_http":       network["gsa_start_http"],
+		"gsa_finish_http":      network["gsa_finish_http"],
+		"start_provisioning":   record{"dsid": fmt.Sprintf("%#x", machineDSID), "spim_hex": network["spim_hex"], "cpim_hex": hx(primary.CPIM), "session": primary.Session},
+		"end_provisioning":     record{"session": primary.Session, "ptm_hex": network["ptm_hex"], "tk_hex": network["tk_hex"]},
+		"request_otp":          record{"dsid": fmt.Sprintf("%#x", machineDSID), "mid_hex": hx(primary.MID), "otp_hex": hx(primary.OTP)},
+		"adi_state_hex":        hx(primary.State),
+		"anisette_headers":     headers,
+		"anisette_state_json":  record{"Identifier": base64.StdEncoding.EncodeToString(adiIdentifier), "Provisioning": base64.StdEncoding.EncodeToString(primary.State), "RoutingInfo": rinfo},
+		"xpc":                  primary.XPC,
+		"alt_seed":             record{"cpim_hex": hx(alternate.CPIM), "session": alternate.Session},
+		"deterministic_replay": ok,
+		"observed_sources":     primary.Sources,
+	})
+}
+
+// commandADIVerify replays adi.json offline in a fresh process.
+func commandADIVerify(ctx context.Context, out string) {
+	var fixture map[string]any
+	readJSON(out, "adi.json", &fixture)
+	adiIdentifier = mustHex(fixture["identifier_hex"].(string))
+	start := fixture["start_provisioning"].(map[string]any)
+	end := fixture["end_provisioning"].(map[string]any)
+	otp := fixture["request_otp"].(map[string]any)
+	network := record{"spim_hex": start["spim_hex"], "ptm_hex": end["ptm_hex"], "tk_hex": end["tk_hex"]}
+	run := runADI(ctx, loadBundle(ctx), seedPrimary, &network, false)
+	fmt.Println("ADI offline replay vs adi.json:")
+	same("cpim", run.CPIM, mustHex(start["cpim_hex"].(string)))
+	same("mid", run.MID, mustHex(otp["mid_hex"].(string)))
+	same("otp", run.OTP, mustHex(otp["otp_hex"].(string)))
+	same("state", run.State, mustHex(fixture["adi_state_hex"].(string)))
+}
