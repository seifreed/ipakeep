+++ b/harness/amd.go
@@ -0,0 +1,217 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/binary"
+	"fmt"
+	"time"
+
+	"github.com/majd/ipatool/v2/internal/golden"
+	"github.com/majd/ipatool/v2/internal/sap/assets"
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+	"github.com/majd/ipatool/v2/internal/store/emulator"
+	"github.com/majd/ipatool/v2/internal/store/profile"
+)
+
+var amdURLs = []string{
+	"https://p25-buy.itunes.apple.com/WebObjects/MZFinance.woa/wa/volumeStoreDownloadProduct?guid=020000000001",
+	"https://downloaddispatch.itunes.apple.com/WebObjects/DownloadDispatch.woa/wa/ent/download?guid=020000000001",
+}
+
+var (
+	dsidMinus1 = bytes.Repeat([]byte{0xff}, 8)
+	dsidMinus2 = append(bytes.Repeat([]byte{0xff}, 7), 0xfe)
+)
+
+type amdExchange struct {
+	OriginalRequestHex  string `json:"original_request_hex"`
+	ForwardedRequestHex string `json:"forwarded_request_hex"`
+	ReplyHex            string `json:"reply_hex"`
+}
+
+type amdRun struct {
+	Headers   map[string]string
+	Exchanges []amdExchange
+	Err       string
+	Request   []byte
+}
+
+// runAMD executes AMSAnisette type 2. With rewrite, the adid request's DSID
+// -1 is forwarded as -2 (the only DSID GSA machine provisioning accepts), and
+// the RNG/time are re-frozen right before the daemon runs.
+func runAMD(ctx context.Context, bundle assets.Bundle, prepared profile.Data, state, seed []byte, at time.Time, endpoint string, rewrite bool) amdRun {
+	freeze(seed)
+	adi, err := machine.OpenModernADI(ctx, bundle, adiIdentifier, state)
+	check(err, "open ADI")
+	defer adi.Close()
+	framework, err := emulator.Open(ctx, bundle.AppleMediaServices, prepared)
+	check(err, "open AMS")
+	defer framework.Close()
+	var run amdRun
+	headers, err := framework.StoreAMDHeaders(endpoint, hardwareID, func(service string, request []byte) ([]byte, error) {
+		if service != "com.apple.adid" {
+			return nil, fmt.Errorf("unexpected service %s", service)
+		}
+		run.Request = append([]byte(nil), request...)
+		forwarded := append([]byte(nil), request...)
+		if rewrite && len(forwarded) == 20 && bytes.Equal(forwarded[12:20], dsidMinus1) {
+			copy(forwarded[12:20], dsidMinus2)
+		}
+		golden.Freeze(at, seed)
+		reply, err := adi.ExchangeXPC(forwarded)
+		run.Exchanges = append(run.Exchanges, amdExchange{hx(request), hx(forwarded), hx(reply)})
+		return reply, err
+	})
+	run.Headers = headers
+	if err != nil {
+		run.Err = err.Error()
+	}
+	return run
+}
+
+func directReply(ctx context.Context, bundle assets.Bundle, state, seed []byte, at time.Time, request []byte) []byte {
+	freeze(seed)
+	adi, err := machine.OpenModernADI(ctx, bundle, adiIdentifier, state)
+	check(err, "open ADI")
+	defer adi.Close()
+	golden.Freeze(at, seed)
+	reply, err := adi.ExchangeXPC(request)
+	check(err, "direct ExchangeXPC")
+	return reply
+}
+
+type otpRun struct {
+	MID, OTP []byte
+	XPC      []xpcPair
+}
+
+func requestOTP(ctx context.Context, bundle assets.Bundle, state, seed []byte, at time.Time, dsid uint64) (otpRun, error) {
+	freeze(seed)
+	adi, err := machine.OpenModernADI(ctx, bundle, adiIdentifier, state)
+	check(err, "open ADI")
+	defer adi.Close()
+	golden.Freeze(at, seed)
+	traceXPC()
+	defer func() { golden.XPCTrace = nil }()
+	mid, otp, err := adi.RequestOTP(dsid)
+	return otpRun{MID: mid, OTP: otp, XPC: takeXPC()}, err
+}
+
+// parseOTPReply splits adid's reply: be32 status, be32 len, mid, be32 len, otp.
+func parseOTPReply(reply []byte) (status uint32, mid, otp []byte) {
+	if len(reply) < 4 {
+		return 0, nil, nil
+	}
+	status = binary.BigEndian.Uint32(reply)
+	rest := reply[4:]
+	take := func() []byte {
+		if len(rest) < 4 {
+			return nil
+		}
+		n := int(binary.BigEndian.Uint32(rest))
+		if len(rest) < 4+n {
+			return nil
+		}
+		out := rest[4 : 4+n]
+		rest = rest[4+n:]
+		return out
+	}
+	mid = take()
+	otp = take()
+	return status, mid, otp
+}
+
+func b64(data []byte) string { return base64.StdEncoding.EncodeToString(data) }
+
+func commandAMD(ctx context.Context, out string) {
+	bundle := loadBundle(ctx)
+	prepared, err := profile.Load(ctx)
+	check(err, "profile")
+	var adiFixture map[string]any
+	readJSON(out, "adi.json", &adiFixture)
+	adiIdentifier = mustHex(adiFixture["identifier_hex"].(string))
+	state := mustHex(adiFixture["adi_state_hex"].(string))
+	later := fixedTime.Add(90 * time.Second)
+
+	genuine := runAMD(ctx, bundle, prepared, state, seedPrimary, fixedTime, amdURLs[0], false)
+	fmt.Println("AMS genuine (dsid -1, not provisioned):", genuine.Err)
+
+	primary := runAMD(ctx, bundle, prepared, state, seedPrimary, fixedTime, amdURLs[0], true)
+	check(errorOf(primary.Err), "AMD rewrite run")
+	replay := runAMD(ctx, bundle, prepared, state, seedPrimary, fixedTime, amdURLs[0], true)
+	otherURL := runAMD(ctx, bundle, prepared, state, seedPrimary, fixedTime, amdURLs[1], true)
+	otherSeed := runAMD(ctx, bundle, prepared, state, seedAlternate, fixedTime, amdURLs[0], true)
+	otherTime := runAMD(ctx, bundle, prepared, state, seedPrimary, later, amdURLs[0], true)
+
+	forwarded := mustHex(primary.Exchanges[0].ForwardedRequestHex)
+	direct := directReply(ctx, bundle, state, seedPrimary, fixedTime, forwarded)
+	status, mid, otp := parseOTPReply(direct)
+	viaAPI, apiErr := requestOTP(ctx, bundle, state, seedPrimary, fixedTime, machineDSID)
+	check(apiErr, "RequestOTP(-2)")
+	apiMinus1, minus1Err := requestOTP(ctx, bundle, state, seedPrimary, fixedTime, amdDSID)
+
+	fmt.Println("AMD determinism / sensitivity:")
+	deterministic := same("replay X-Apple-AMD", []byte(primary.Headers["X-Apple-AMD"]), []byte(replay.Headers["X-Apple-AMD"]))
+	deterministic = same("replay X-Apple-AMD-M", []byte(primary.Headers["X-Apple-AMD-M"]), []byte(replay.Headers["X-Apple-AMD-M"])) && deterministic
+	urlIndependent := same("other URL same AMD", []byte(primary.Headers["X-Apple-AMD"]), []byte(otherURL.Headers["X-Apple-AMD"]))
+	seedIndependent := same("other seed same AMD", []byte(primary.Headers["X-Apple-AMD"]), []byte(otherSeed.Headers["X-Apple-AMD"]))
+	timeIndependent := same("other time same AMD", []byte(primary.Headers["X-Apple-AMD"]), []byte(otherTime.Headers["X-Apple-AMD"]))
+	midStable := same("other time same AMD-M", []byte(primary.Headers["X-Apple-AMD-M"]), []byte(otherTime.Headers["X-Apple-AMD-M"]))
+
+	fmt.Println("AMD hypothesis:")
+	requestIsOTP := len(apiMinus1.XPC) > 0 && apiMinus1.XPC[0].RequestHex == hx(genuine.Request)
+	fmt.Printf("  %-40s %v\n", "AMS request == RequestOTP(-1) request", requestIsOTP)
+	replyEqual := same("AMS-path reply == direct reply", mustHex(primary.Exchanges[0].ReplyHex), direct)
+	amdIsOTP := same("X-Apple-AMD == b64(reply.otp)", []byte(primary.Headers["X-Apple-AMD"]), []byte(b64(otp)))
+	amdMIsMID := same("X-Apple-AMD-M == b64(reply.mid)", []byte(primary.Headers["X-Apple-AMD-M"]), []byte(b64(mid)))
+	apiOTP := same("RequestOTP(-2).otp == reply.otp", viaAPI.OTP, otp)
+	apiMID := same("RequestOTP(-2).mid == reply.mid", viaAPI.MID, mid)
+
+	writeJSON(out, "amd.json", record{
+		"description":         "AMSAnisette _headersForRequest:account:nil type:2 (Store AMD) run in the AppleMediaServices emulator, com.apple.adid served by ModernADI.ExchangeXPC. Input ADI = adi.json (GSA machine provisioning, dsid -2).",
+		"identifier_hex":      hx(adiIdentifier),
+		"hardware_id_hex":     hx(hardwareID),
+		"input_adi_state":     "adi.json adi_state_hex",
+		"url":                 amdURLs[0],
+		"genuine_dsid_minus1": record{"xpc_request_hex": hx(genuine.Request), "exchanges": genuine.Exchanges, "error": genuine.Err, "note": "adid answers a bare status because dsid -1 is only provisioned by the account-bound Store 'SP' action"},
+		"rewritten_dsid_minus2": record{
+			"note":                 "the handler forwards the AMS request with bytes[12:20] changed from ff..ff to ff..fe; time/RNG re-frozen to fixed_time/seed right before adid runs",
+			"exchanges":            primary.Exchanges,
+			"headers":              primary.Headers,
+			"other_url_headers":    otherURL.Headers,
+			"other_seed_headers":   otherSeed.Headers,
+			"plus90s_headers":      otherTime.Headers,
+			"deterministic_replay": deterministic,
+			"url_independent":      urlIndependent,
+			"seed_independent":     seedIndependent,
+			"time_independent_amd": timeIndependent,
+			"time_independent_mid": midStable,
+		},
+		"direct_reply":       record{"request_hex": hx(forwarded), "reply_hex": hx(direct), "status": status, "mid_hex": hx(mid), "otp_hex": hx(otp), "mid_b64": b64(mid), "otp_b64": b64(otp)},
+		"request_otp_minus2": record{"mid_hex": hx(viaAPI.MID), "otp_hex": hx(viaAPI.OTP), "xpc": viaAPI.XPC},
+		"request_otp_minus1": record{"error": errString(minus1Err), "xpc": apiMinus1.XPC},
+		"verdict": record{
+			"ams_request_equals_request_otp_minus1_request": requestIsOTP,
+			"ams_reply_equals_direct_reply":                 replyEqual,
+			"x_apple_amd_equals_b64_otp":                    amdIsOTP,
+			"x_apple_amd_m_equals_b64_mid":                  amdMIsMID,
+			"request_otp_api_matches_reply":                 apiOTP && apiMID,
+		},
+	})
+}
+
+func errorOf(message string) error {
+	if message == "" {
+		return nil
+	}
+	return fmt.Errorf("%s", message)
+}
+
+func errString(err error) string {
+	if err == nil {
+		return ""
+	}
+	return err.Error()
+}
