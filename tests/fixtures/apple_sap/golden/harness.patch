+package main
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+
+	"github.com/majd/ipatool/v2/internal/store"
+	"github.com/majd/ipatool/v2/internal/storeauth"
+	apphttp "github.com/majd/ipatool/v2/pkg/http"
+)
+
+// commandWireSelfTest drives both hooked HTTP paths without an account.
+func commandWireSelfTest(ctx context.Context, _ string) {
+	client := storeauth.NewHTTPClient(nil)
+	response, err := client.Get("https://s.mzstatic.com/sap/setupCert.plist")
+	check(err, "storeauth GET")
+	_, _ = io.Copy(io.Discard, response.Body)
+	_ = response.Body.Close()
+	backend := store.New(nil, func() (string, error) { return "02:00:00:00:00:01", nil })
+	result, err := backend.Client("bag-direct").Send(apphttp.Request{Context: ctx, Method: http.MethodGet, URL: "https://init.itunes.apple.com/bag.xml?ix=6&guid=020000000001", Headers: map[string]string{"Accept": "application/xml"}}, nil)
+	check(err, "backend bag-direct")
+	_ = result.Body.Close()
+	lookup, err := backend.Client("request").Send(apphttp.Request{Context: ctx, Method: http.MethodGet, URL: "https://itunes.apple.com/lookup?id=284882215&entity=software", ResponseFormat: apphttp.ResponseFormatJSON}, nil)
+	check(err, "backend emulated lookup")
+	_ = lookup.Body.Close()
+	fmt.Println("statuses", response.StatusCode, result.StatusCode, lookup.StatusCode)
+}
