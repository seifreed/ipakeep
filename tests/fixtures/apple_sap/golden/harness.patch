index 0000000..240f3e8
--- /dev/null
+++ b/wire/redact.py
@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""Redact an IPAKEEP_WIRE_LOG JSONL capture before sharing it.
+
+Usage:
+  python3 -I redact.py IN.jsonl OUT.jsonl [--literal VALUE ...]
+
+Every secret is replaced by "[R:name:len=N:id=XXXXXXXX]", where id is an
+HMAC with a random per-run key: equal values inside one capture keep the same
+id (so request/response correlation survives) but cannot be reversed or
+brute-forced across captures. Pass --literal for any extra value (Apple ID
+email, DSID, real MAC/guid, first/last name, phone digits) to scrub it from
+every URL, header and text body as a plain substring.
+"""
+import argparse
+import base64
+import hashlib
+import hmac
+import json
+import os
+import re
+import sys
+import urllib.parse
+
+KEY = os.urandom(32)
+
+SECRET_HEADERS = re.compile(
+    r"cookie|token|dsid|^x-apple-i-md|^x-apple-amd|device-id|authorization|"
+    r"x-apple-i-md-lu|x-apple-id|x-apple-hb|x-apple-gs|session|^x-mme|"
+    r"x-apple-i-srl-no|x-apple-tz|^x-dsid|^icloud|x-apple-store-front|x-apple-ams-|^x-jsession",
+    re.I,
+)
+SECRET_KEYS = {
+    "appleid", "password", "passwordtoken", "clearToken".lower(), "dspersonid",
+    "dsid", "directoryservicesid", "kbsync", "guid", "serialnumber", "machinename",
+    "email", "firstname", "lastname", "accountinfo", "sinf", "sinfs",
+    "keybag", "x-token", "mt-tkn", "downloadkey", "download-key", "clientdata",
+    "settinginfo", "transportkey", "cpim", "spim", "ptm", "tk", "x-apple-i-md",
+    "x-apple-i-md-m", "x-apple-amd", "x-apple-amd-m", "creditdisplay",
+    "accountname", "storefront", "phonenumber", "trusteddevices", "code",
+    "securitycode", "attempt", "rmd", "dsidstring", "account-id", "pings",
+    "hsa2", "x-apple-i-md-rinfo", "rinfo", "salt", "a", "b", "m1", "m2", "c",
+    "sc", "spd", "np",
+}
+
+
+def tag(name, value):
+    raw = value if isinstance(value, bytes) else str(value).encode()
+    digest = hmac.new(KEY, raw, hashlib.sha256).hexdigest()[:8]
+    return f"[R:{name}:len={len(raw)}:id={digest}]"
+
+
+def scrub_literals(text, literals):
+    for literal in literals:
+        if literal:
+            text = text.replace(literal, tag("literal", literal))
+            encoded = urllib.parse.quote(literal, safe="")
+            if encoded != literal:
+                text = text.replace(encoded, tag("literal", literal))
+    return text
+
+
+def redact_json(value, literals):
+    if isinstance(value, dict):
+        return {k: (tag(k, json.dumps(v)) if k.lower() in SECRET_KEYS else redact_json(v, literals)) for k, v in value.items()}
+    if isinstance(value, list):
+        return [redact_json(v, literals) for v in value]
+    if isinstance(value, str):
+        return scrub_literals(value, literals)
+    return value
+
+
+PLIST_ITEM = re.compile(
+    r"(<key>([^<]+)</key>\s*)(<(string|data|integer|real|date)>(.*?)</\4>)",
+    re.S,
+)
+
+
+def redact_plist(text):
+    def replace(match):
+        key = match.group(2)
+        if key.lower() not in SECRET_KEYS:
+            return match.group(0)
+        return f"{match.group(1)}<string>{tag(key, match.group(5))}</string>"
+
+    return PLIST_ITEM.sub(replace, text)
+
+
+def redact_form(text):
+    pairs = urllib.parse.parse_qsl(text, keep_blank_values=True)
+    if not pairs or "=" not in text:
+        return None
+    return urllib.parse.urlencode([(k, tag(k, v) if k.lower() in SECRET_KEYS else v) for k, v in pairs])
+
+
+def redact_text(text, literals):
+    stripped = text.lstrip()
+    if stripped.startswith("{") or stripped.startswith("["):
+        try:
+            return json.dumps(redact_json(json.loads(text), literals))
+        except ValueError:
+            pass
+    if "<plist" in text or "<key>" in text:
+        return scrub_literals(redact_plist(text), literals)
+    form = redact_form(text) if "&" in text or "=" in text else None
+    if form is not None and "<" not in text:
+        return scrub_literals(form, literals)
+    return scrub_literals(text, literals)
+
+
+def redact_url(url, literals):
+    parts = urllib.parse.urlsplit(url)
+    query = urllib.parse.parse_qsl(parts.query, keep_blank_values=True)
+    query = [(k, tag(k, v) if k.lower() in SECRET_KEYS else v) for k, v in query]
+    rebuilt = urllib.parse.urlunsplit(parts._replace(query=urllib.parse.urlencode(query)))
+    return scrub_literals(rebuilt, literals)
+
+
+def redact_body(body, literals):
+    if not body:
+        return body
+    if body.get("text"):
+        body["text"] = redact_text(body["text"], literals)
+    if body.get("base64"):
+        raw = base64.b64decode(body["base64"])
+        body["base64"] = tag("binary-body", raw)
+    return body
+
+
+def redact_entry(entry, literals):
+    entry["url"] = redact_url(entry.get("url", ""), literals)
+    headers = entry.get("headers") or {}
+    entry["headers"] = {
+        k: [tag(k, v) if SECRET_HEADERS.search(k) else scrub_literals(v, literals) for v in values]
+        for k, values in headers.items()
+    }
+    entry["body"] = redact_body(entry.get("body"), literals)
+    if entry.get("error"):
+        entry["error"] = scrub_literals(entry["error"], literals)
+    return entry
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("input")
+    parser.add_argument("output")
+    parser.add_argument("--literal", action="append", default=[])
+    args = parser.parse_args()
+    literals = sorted(set(args.literal), key=len, reverse=True)
+    count = 0
+    with open(args.input) as source, open(args.output, "w") as sink:
+        for line in source:
+            if line.strip():
+                sink.write(json.dumps(redact_entry(json.loads(line), literals)) + "\n")
+                count += 1
+    print(f"redacted {count} entries -> {args.output}", file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main()
