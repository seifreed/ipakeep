+package main
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/majd/ipatool/v2/internal/golden"
+	"github.com/majd/ipatool/v2/internal/sap/machine"
+)
+
+var timeShift bool
+
+func commandKBSync(ctx context.Context, out string) {
+	bundle := loadBundle(ctx)
+	generate := func(seed []byte) ([]byte, map[string]int) {
+		freeze(seed)
+		if timeShift {
+			golden.Freeze(laterTime, seed)
+		}
+		blob, err := machine.GenerateKBSync(ctx, bundle, hardwareID, kbsyncDSID)
+		check(err, "kbsync")
+		return blob, sources()
+	}
+	first, observed := generate(seedPrimary)
+	second, _ := generate(seedPrimary)
+	alternate, _ := generate(seedAlternate)
+	timeShift = true
+	shifted, _ := generate(seedPrimary)
+	fmt.Println("kbsync:")
+	deterministic := same("same seed", first, second)
+	seedIndependent := same("alternate seed", first, alternate)
+	timeIndependent := same("fixed_time+90s", first, shifted)
+	writeJSON(out, "kbsync.json", record{
+		"description":          "StoreAgent GenerateKBSync(hardwareID, dsid) with no SC Info file present (fresh virtual filesystem)",
+		"hardware_id_hex":      hx(hardwareID),
+		"dsid":                 kbsyncDSID,
+		"kbsync_hex":           hx(first),
+		"kbsync_alt_seed_hex":  hx(alternate),
+		"deterministic_replay": deterministic,
+		"seed_independent":     seedIndependent,
+		"time_independent":     timeIndependent,
+		"observed_sources":     observed,
+	})
+}
